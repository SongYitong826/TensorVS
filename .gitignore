# Publish library source, usage documentation, and library tests only.
/*
!/.gitattributes
!/.gitignore
!/.gitmodules
!/README.md
!/pyproject.toml
!/src/
!/tests/
!/docs/
!/flash-kmeans

/docs/*
!/docs/usage.md
!/docs/assets/
/docs/assets/*
!/docs/assets/tensorvs-icon.png

/tests/*
!/tests/test_coarse_selection.py
!/tests/test_index.py
!/tests/test_kmeans_training.py
!/tests/test_pq_adc_access.py
!/tests/test_pq_lut_order.py
!/tests/test_pq_region_topk.py
!/tests/test_search_backends.py
!/tests/test_torch_baseline.py
!/tests/test_training_norm_memory.py
!/tests/test_high_dimensional_pq.py

# Generated files are never part of the source distribution.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
*.csv
*.json
*.pdf
*.npy
*.npz
*.pt
*.pth
*.bin
*.fvecs
*.ivecs
*.log
